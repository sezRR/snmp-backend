# Copy to `.env` before starting the stack. Compose reads it both to expand
# compose.yaml and as the API container's environment. Real environment
# variables take precedence during interpolation.
#
# PGHOST and PGPORT below are for host tools. compose.yaml overrides them inside
# the API container so it reaches the database over the Compose network.

# ---- Database ---------------------------------------------------------------
# Host-run uvicorn against the Compose database: PGHOST=localhost, PGPORT=15432.
# compose.yaml publishes 15432 on loopback; host-side Alembic targets read these.
PGHOST=localhost
PGPORT=15432
PGDATABASE=app
PGUSER=app
PGPASSWORD=dev-only-not-a-secret
PGSSLMODE=prefer

# SQLAlchemy's pool_size is the persistent pool, not a floor: connections past
# it are opened and closed per checkout, so 1 would churn under load.
DB_POOL_MIN=5
DB_POOL_MAX=16
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
# Run `alembic upgrade head` on startup. Turn off to migrate separately with
# `python -m app.db.migrate`.
DB_AUTO_MIGRATE=true
DB_INIT_MAX_ATTEMPTS=30
DB_INIT_RETRY_SECONDS=2.0

# ---- Auth -------------------------------------------------------------------
# REQUIRED, and left blank on purpose: the app refuses to start without it, so a
# copied .env fails loudly rather than running on a guessable signing key.
#
#   openssl rand -hex 32
#
# Changing it invalidates every token already issued, which logs everyone out.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=snmp-metrics-api
# Access tokens cannot be revoked — they carry their own scopes and are checked
# without a database round trip — so they are short. Refresh tokens are recorded
# per session and can be revoked, so they are long.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
PASSWORD_MIN_LENGTH=12
# EventSource cannot send an Authorization header, so a browser exchanges its
# token for a single-use ticket. Short enough that one left in an access log is
# already useless.
STREAM_TICKET_TTL_SECONDS=30
# Failed logins are counted per username and per client address, and either
# limit reached answers 429 with Retry-After until the window slides past. Both
# halves matter: the username counter alone would let anyone lock any account
# out from anywhere, the address counter alone would ignore a distributed
# attack on one account. A successful login clears the username's count only.
#
# Counters are per process, so with more than one API process the effective limit
# is multiplied by the process count. Set _ENABLED=false to turn the check off.
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX_PER_USER=5
LOGIN_RATE_LIMIT_MAX_PER_IP=20

# ---- Admin bootstrap ---------------------------------------------------------
# Both REQUIRED. Without an admin account nothing can be administered, so a
# backend that cannot create one refuses to start.
#
# The role is reconciled on every boot — a scope added to the code lands on it
# automatically. The password is written once, at creation: a password changed
# through the API is not reverted by a stale value here. Set
# ADMIN_PASSWORD_RESET=true for one boot to force-rotate a lost password, then
# unset it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_RESET=false

# ---- Collector --------------------------------------------------------------
COLLECTOR_ENABLED=true
COLLECTOR_INTERVAL_SECONDS=5
# Bounds SNMP calls in flight, not database connections: a tick issues two or
# three queries no matter how many machines it samples.
COLLECTOR_CONCURRENCY=32
# Wall-clock ceiling on one machine's sample. 0 derives it from the interval
# (80% of it), which keeps a slow agent from holding a slot across a whole
# period. Watch effective_interval_seconds on GET /admin/collector to see
# whether the configured cadence is actually being met.
COLLECTOR_SAMPLE_TIMEOUT_SECONDS=0

# ---- SNMP -------------------------------------------------------------------
# true: generate plausible samples locally. false: real pysnmp queries.
SNMP_SIMULATE=true
# Read exactly once, on the first boot that finds no `default-v2c` credential:
# it becomes that profile and every existing machine is bound to it. After that
# the sampler never looks at it again — credentials are rows, and there is no
# fallback community string. Removable once every installation has had that boot.
SNMP_COMMUNITY=public
SNMP_PORT=161
# Worst case per machine is TIMEOUT * (RETRIES + 1).
SNMP_TIMEOUT_SECONDS=1.5
SNMP_RETRIES=1
SNMP_MAX_REPETITIONS=10
# Disk throughput and IOPS from UCD DISKIO-MIB. Needs an snmpd with the diskio
# module and 1.3.6.1.4.1.2021.13.15 in its view; see the README. Costs about six
# extra walks per machine.
SNMP_DISKIO_ENABLED=true

# ---- SNMP credential encryption ----------------------------------------------
# SNMPv3 passphrases are stored encrypted, not hashed: pysnmp needs the
# plaintext to localize a USM key on every request, so there is nothing to
# compare a hash against. AES-256-GCM, keys held here.
#
# This is a key *ring*, and having more than one entry is the whole point. Each
# stored credential records which key sealed it, so rotation is: add a key, flip
# ACTIVE_KEY, recreate the API container, run `python -m app.db.reencrypt`, then
# drop the old key.
# Rows keep decrypting the entire time — no re-entry of any passphrase.
#
# Generate a key with: openssl rand -hex 32
# The value below is a committed dev key. Replace it anywhere real; if it leaks
# together with a database dump, every stored credential is readable.
SNMP_CREDENTIAL_KEYS={"dev":"00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"}
SNMP_CREDENTIAL_ACTIVE_KEY=dev

# ---- Metric retention --------------------------------------------------------
# TimescaleDB background jobs on the metrics hypertable. Either at 0 disables
# that policy.
METRICS_COMPRESS_AFTER_HOURS=24
METRICS_RETENTION_DAYS=30

# ---- OpenStack --------------------------------------------------------------
# true: fake fleet. false: read-only Nova/Keystone/Neutron lookup with a Keystone
# password. No network is configured: every network a server is attached to is
# walked, and the first fixed IPv4 with a MAC is the one the collector uses.
OPENSTACK_SIMULATE=true
OPENSTACK_CACHE_TTL_SECONDS=300
OPENSTACK_API_TIMEOUT_SECONDS=10
# The /v3 suffix is expected: it is the identity API this authenticates against.
OS_AUTH_URL=
# Identify the user by *either* OS_USER_ID (a UUID, unique on its own) or
# OS_USERNAME (a name, unique only inside OS_USER_DOMAIN_ID). Setting OS_USER_ID
# wins and the name and domain are then not sent at all.
OS_USERNAME=
OS_USER_ID=
OS_PASSWORD=
OS_USER_DOMAIN_ID=default
# The project the session is scoped to, as a UUID.
OS_PROJECT_ID=
OS_REGION_NAME=
OS_INTERFACE=public
# Optional CA bundle path. TLS verification is never disabled.
OS_CACERT=

# ---- API --------------------------------------------------------------------
# Optional prefix when the API is served behind a reverse proxy.
ROOT_PATH=
API_PORT=8000
# Addresses allowed to supply proxy headers. Keep the loopback default unless a
# trusted reverse proxy is added, then list only that proxy's addresses.
FORWARDED_ALLOW_IPS=127.0.0.1
SSE_HEARTBEAT_SECONDS=15
SSE_QUEUE_MAXSIZE=100
LOG_LEVEL=INFO
# Set true if file events do not cross the macOS/Linux bind mount boundary.
WATCHFILES_FORCE_POLLING=false
