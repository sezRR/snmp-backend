# Copy to `.env` before starting the stack. Compose reads it both to expand
# compose.yaml and as the API container's environment. Real environment
# variables take precedence during interpolation.
#
# PGHOST and PGPORT below are for host tools. compose.yaml overrides them inside
# the API container so it reaches the database over the Compose network.

# ---- Database ---------------------------------------------------------------
# Host-run uvicorn against the Compose database: PGHOST=localhost, PGPORT=15432.
# compose.yaml publishes 15432 on loopback; host-side Alembic targets read these.
PGHOST=localhost
PGPORT=15432
# REQUIRED, all three. The application refuses to start without them and
# Compose refuses to interpolate without them, so a database is never reached
# with a guessed name, a guessed user or an empty password.
#
#   openssl rand -hex 16
PGDATABASE=snmpmetricsdb
PGUSER=admin
PGPASSWORD=
PGSSLMODE=prefer

# SQLAlchemy's pool_size is the persistent pool, not a floor: connections past
# it are opened and closed per checkout, so 1 would churn under load.
DB_POOL_MIN=5
DB_POOL_MAX=16
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
# Run `alembic upgrade head` on startup. Turn off to migrate separately with
# `python -m app.db.migrate`.
DB_AUTO_MIGRATE=true
DB_INIT_MAX_ATTEMPTS=30
DB_INIT_RETRY_SECONDS=2.0

# ---- Auth -------------------------------------------------------------------
# REQUIRED, and left blank on purpose: the app refuses to start without it, so a
# copied .env fails loudly rather than running on a guessable signing key.
#
#   openssl rand -hex 32
#
# Changing it invalidates every token already issued, which logs everyone out.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=snmp-metrics-api
# Access tokens cannot be revoked — they carry their own scopes and are checked
# without a database round trip — so they are short. Refresh tokens are recorded
# per session and can be revoked, so they are long.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
PASSWORD_MIN_LENGTH=12
# EventSource cannot send an Authorization header, so a browser exchanges its
# token for a single-use ticket. Short enough that one left in an access log is
# already useless.
STREAM_TICKET_TTL_SECONDS=30
# Ending a session (a password change, a disabled account) bumps
# users.session_epoch, and access tokens minted under an older one are refused.
# This is how long a process trusts its cached copy of that column. It does not
# bound how long a revoked session survives — a token that disagrees with the
# cache is always checked against the row — only how long a second process can
# go without having been shown the new epoch.
SESSION_EPOCH_CACHE_TTL_SECONDS=10
# Failed logins are counted per username and per client address, and either
# limit reached answers 429 with Retry-After until the window slides past. Both
# halves matter: the username counter alone would let anyone lock any account
# out from anywhere, the address counter alone would ignore a distributed
# attack on one account. A successful login clears the username's count only.
#
# Counters are per process, so with more than one API process the effective limit
# is multiplied by the process count. Set _ENABLED=false to turn the check off.
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX_PER_USER=5
LOGIN_RATE_LIMIT_MAX_PER_IP=20

# ---- Admin bootstrap ---------------------------------------------------------
# Both REQUIRED. Without an admin account nothing can be administered, so a
# backend that cannot create one refuses to start.
#
# The role is reconciled on every boot — a scope added to the code lands on it
# automatically. The password is written once, at creation: a password changed
# through the API is not reverted by a stale value here. Set
# ADMIN_PASSWORD_RESET=true for one boot to force-rotate a lost password, then
# unset it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_RESET=false

# ---- Collector --------------------------------------------------------------
COLLECTOR_ENABLED=true
COLLECTOR_INTERVAL_SECONDS=5
# Bounds SNMP calls in flight, not database connections: a tick issues two or
# three queries no matter how many machines it samples.
COLLECTOR_CONCURRENCY=32
# Wall-clock ceiling on one machine's sample. 0 derives it from the interval
# (80% of it), which keeps a slow agent from holding a slot across a whole
# period. Watch effective_interval_seconds on GET /admin/collector to see
# whether the configured cadence is actually being met.
COLLECTOR_SAMPLE_TIMEOUT_SECONDS=0

# ---- SNMP -------------------------------------------------------------------
# Read exactly once, on the first boot that finds no `default-v2c` credential:
# it becomes that profile and every existing machine is bound to it. After that
# the sampler never looks at it again — credentials are rows, and there is no
# fallback community string. Removable once every installation has had that boot.
SNMP_COMMUNITY=public
SNMP_PORT=161
# Worst case per machine is TIMEOUT * (RETRIES + 1).
SNMP_TIMEOUT_SECONDS=1.5
SNMP_RETRIES=1
SNMP_MAX_REPETITIONS=10
# Disk throughput and IOPS from UCD DISKIO-MIB. Needs an snmpd with the diskio
# module and 1.3.6.1.4.1.2021.13.15 in its view; see the README. Costs about six
# extra walks per machine.
SNMP_DISKIO_ENABLED=true

# ---- SNMP credential encryption ----------------------------------------------
# SNMPv3 passphrases are stored encrypted, not hashed: pysnmp needs the
# plaintext to localize a USM key on every request, so there is nothing to
# compare a hash against. AES-256-GCM, keys held here.
#
# This is a key *ring*, and having more than one entry is the whole point. Each
# stored credential records which key sealed it, so rotation is: add a key, flip
# ACTIVE_KEY, recreate the API container, run `python -m app.db.reencrypt`, then
# drop the old key.
# Rows keep decrypting the entire time — no re-entry of any passphrase.
#
# REQUIRED, both. Without the ring nothing decrypts, so every v3 machine fails
# every tick while the backend reports itself healthy — it refuses to start
# instead.
#
# Generate a key with: openssl rand -hex 32
# The value below is a committed dev key. Replace it anywhere real; if it leaks
# together with a database dump, every stored credential is readable.
SNMP_CREDENTIAL_KEYS={"dev":"00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"}
SNMP_CREDENTIAL_ACTIVE_KEY=dev

# ---- Metric retention --------------------------------------------------------
# TimescaleDB background jobs on the metrics hypertable. Any of these at 0
# disables that policy.
#
# The raw window is short on purpose: it is for live troubleshooting, and
# anything older is served from the rollups below. These three are tied to each
# other. A chunk only becomes eligible for compression once its *end* is
# COMPRESS_AFTER in the past, so day-long chunks with a 24 hour window are not
# compressed until they are two days old - which against a three day retention
# would leave most of the window uncompressed.
METRICS_COMPRESS_AFTER_HOURS=8
METRICS_RETENTION_DAYS=3
# New chunks only; existing chunks keep their interval and age out.
METRICS_CHUNK_INTERVAL_HOURS=4

# ---- Metric rollups ----------------------------------------------------------
# The metrics_1m and metrics_1h continuous aggregates. These are what make a
# long range chart answerable once the raw window is three days, so raise these
# rather than METRICS_RETENTION_DAYS if history goes missing.
#
# Roughly 122 bytes per machine per bucket once compressed, measured: the
# 90 day minute rollup is about 16 MB per machine and is the largest single
# consumer here. The two year hourly rollup is about 2 MB.
METRICS_ROLLUP_1M_RETENTION_DAYS=90
METRICS_ROLLUP_1H_RETENTION_DAYS=730
# How far back a refresh reaches. Must stay shorter than METRICS_RETENTION_DAYS
# or a refresh is asked to re-read chunks retention has already dropped, and the
# rollup develops holes exactly where the raw data used to be. Clamped to 75% of
# retention if it does not.
METRICS_ROLLUP_REFRESH_LAG_DAYS=2

# ---- Metric entity classification --------------------------------------------
# Comma separated, matched as prefixes. Both affect what is *stored*; the live
# SSE stream and /metrics/latest still carry every mount and interface.
#
# Mounts whose usage is not a real filesystem's. hrStorageTable reports tmpfs
# under the same type as a real disk, so the path is the only signal there is.
# These are excluded from disk_max_used_pct only. `/tmp` is deliberately absent:
# it is a real filesystem on plenty of hosts.
METRICS_PSEUDO_MOUNT_PREFIXES=/run,/dev/shm,/sys,/proc,/snap,/var/lib/docker/overlay2,/var/lib/kubelet/pods
# Interfaces excluded from the host network totals. A virtual interface cannot
# move a packet off the box by itself - what it carries also crosses a physical
# NIC - so counting both counts the same traffic twice. On a Kubernetes node
# with one veth per pod that inflates the total severalfold.
METRICS_VIRTUAL_IFACE_PREFIXES=veth,cni,flannel,docker,br-,virbr,kube-ipvs,tunl,gre,sit,ip6tnl,tailscale,wg,weave,cali,nomad

# ---- OpenStack --------------------------------------------------------------
# A read-only Nova/Keystone/Neutron lookup with a Keystone password. No network
# is configured: every network a server is attached to is walked, and the first
# fixed IPv4 with a MAC is the one the collector uses.
#
# Everything from OS_AUTH_URL to OS_PROJECT_ID is REQUIRED while
# OPENSTACK_ENABLED is true — copy them from the API Access tab of your
# OpenStack dashboard. The backend refuses to start with any of them missing or
# blank.
#
# Set OPENSTACK_ENABLED=false for a deployment with no OpenStack: no Keystone
# call is made, the OS_* values are neither required nor read, and the fleet is
# empty. Machines are then registered with an explicit `mac` and stored as
# external, so the collector polls the address it was given and never moves it.
OPENSTACK_ENABLED=true
OPENSTACK_CACHE_TTL_SECONDS=300
OPENSTACK_API_TIMEOUT_SECONDS=10
# The /v3 suffix is expected: it is the identity API this authenticates against.
OS_AUTH_URL=
# OS_USER_ID is the UUID and is what goes on the wire; OS_USERNAME is the same
# user by name, unique only inside OS_USER_DOMAIN_ID.
OS_USERNAME=
OS_USER_ID=
OS_PASSWORD=
OS_USER_DOMAIN_ID=
# The project the session is scoped to, as a UUID.
OS_PROJECT_ID=
OS_REGION_NAME=
# Empty leaves the choice to the service catalog: public, internal or admin.
OS_INTERFACE=
# Optional CA bundle path. TLS verification is never disabled.
OS_CACERT=

# ---- API --------------------------------------------------------------------
# Optional prefix when the API is served behind a reverse proxy.
ROOT_PATH=
API_PORT=8000
# Comma separated browser origins allowed to call this API. Matched exactly:
# scheme, host and port all count, so http://localhost:8080 covers neither
# https://localhost:8080 nor http://127.0.0.1:8080. No trailing slash.
# The default is the compose UI port; add the Vite dev server (5173) or
# `vite preview` (4173) while working on the frontend.
#
# `*` works but do not use it here: responses carry credentials, so the caller's
# own origin is echoed back rather than a literal `*` - which means every site
# on the internet may make authenticated requests. Startup warns if it is set.
CORS_ALLOW_ORIGINS=http://localhost:8080
# Addresses allowed to supply proxy headers. Keep the loopback default unless a
# trusted reverse proxy is added, then list only that proxy's addresses.
FORWARDED_ALLOW_IPS=127.0.0.1
SSE_HEARTBEAT_SECONDS=15
SSE_QUEUE_MAXSIZE=100
LOG_LEVEL=INFO
# Set true if file events do not cross the macOS/Linux bind mount boundary.
WATCHFILES_FORCE_POLLING=false
